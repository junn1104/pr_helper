# SenseVoice device
# NVIDIA GPU + CUDA 환경에서는 cuda:0 사용
SENSEVOICE_DEVICE=cuda:0

MAX_AUDIO_SIZE_MB=100

# 로컬 개발 기본값은 SQLite 파일.
# Render 배포 시에는 Render가 제공하는 Postgres Internal Database URL로 교체.
# (postgres:// 로 시작해도 앱에서 자동으로 postgresql:// 로 보정합니다.)
DATABASE_URL=sqlite:///./app.db

GEMINI_API_KEY="구글 AI 스튜디오 API 키"
GEMINI_MODEL=gemini-3.1-flash-lite